#!/bin/bash

SELF=cadc-tomcat-start

CONFDIR=/config
USER=$(whoami)

CONTNAME=${HOSTNAME}
if [ ! -z "${POD_NAME}" ]; then
    # use k8s POD_NAME
    CONTNAME=$POD_NAME
fi

TS=$(date)
JAVA_VERSION=$(rpm -qa 'java-*')
# currently: env from Dockerfile
#TOMCAT_INSTALL=$(rpm -q tomcat)

echo "$TS $SELF START"
echo "host/pod: $CONTNAME"
echo "user: $USER"
echo "home: $HOME"
echo "image version: $IMAGE_VERSION"
echo "java version: $JAVA_VERSION"
echo "tomcat version: $TOMCAT_INSTALL"

# append multiple JVM settings
# JVM setting
JHS=2048m
if [ ! -z "$JAVA_HEAP_SIZE" ]; then
    JHS=$JAVA_HEAP_SIZE
fi
# rpm installed tomcat uses tomcat.conf for environment
#echo JAVA_OPTS=\"-Xms512m -Xmx${JHS} -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \$JAVA_OPTS\" >> $TOMCAT_CONF/tomcat.conf
#echo JAVA_OPTS=\"-XX:+ExitOnOutOfMemoryError \$JAVA_OPTS\" >> $TOMCAT_CONF/tomcat.conf
#echo JAVA_OPTS=\"-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/dumps/heapdump_${CONTNAME}_%t.hprof \$JAVA_OPTS\" >> $TOMCAT_CONF/tomcat.conf
# fedora init scripts sourced tomcat.conf for env: do it manually for now
CATALINA_OPTS="-Xms512m -Xmx${JHS} -XX:+UseG1GC -XX:MaxGCPauseMillis=200"
CATALINA_OPTS="-XX:+ExitOnOutOfMemoryError $CATALINA_OPTS"
CATALINA_OPTS="-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/dumps/heapdump_${CONTNAME}_%t.hprof $CATALINA_OPTS"
export CATALINA_OPTS

if [ -f $CONFDIR/catalina.properties ]; then
    echo "Configure tomcat with extra properties: $CONFDIR/catalina.properties"
    cat $CONFDIR/catalina.properties >> $TOMCAT_CONF/catalina.properties
fi

if [ -f $CONFDIR/war-rename.conf ]; then
    while read line
    do
        MV=$(echo $line | awk '{print $1}')
        if [ "$MV" != "mv" ]; then
            echo "war-rename: $line SKIPPED"
        else
            echo "war-rename: $line"
            cd /usr/share/tomcat/webapps && $line
        fi
    done < $CONFDIR/war-rename.conf
fi

if [ -e $CONFDIR/cacerts ]; then
    echo "Configure CA bundle with extra certificates: $CONFDIR/cacerts"
    cp $CONFDIR/cacerts/* /etc/pki/ca-trust/source/anchors/
fi
if [ -e $CONFDIR/blocked ]; then
    echo "Configure CA bundle with blocked certificates: $CONFDIR/blocked"
    cp $CONFDIR/blocked/* /etc/pki/ca-trust/source/blocklist
fi
CERT_DIR="/opencadc/certs"
update-ca-trust extract --output "$CERT_DIR"

# For OpenSSL:
export SSL_CERT_DIR="$CERT_DIR/pem/directory-hash"
export SSL_CERT_FILE="$CERT_DIR/pem/tls-ca-bundle.pem"

# For java/tomcat:
echo "javax.net.ssl.trustStore=$CERT_DIR/java/cacerts" >> $TOMCAT_CONF/catalina.properties

mkdir -p $HOME/.ssl
chmod 700 $HOME/.ssl
for pcf in $CONFDIR/*.pem; do
    echo "Link proxy certificate: $pcf"   
    ln -s $pcf $HOME/.ssl/
done

ln -s /config $HOME/config

TS=$(date)
echo "$TS $SELF DONE"

# typical for fedora/redhat rpm packages
#/usr/libexec/tomcat/server start

# for apache-tomcat binary tarball
exec /opt/tomcat/bin/catalina.sh run
