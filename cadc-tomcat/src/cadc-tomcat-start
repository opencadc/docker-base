#!/bin/bash

SELF=cadc-tomcat-start

CONFDIR=/config
USER=$(whoami)

CONTNAME=${HOSTNAME}
if [ ! -z "${POD_NAME}" ]; then
    # use k8s POD_NAME
    CONTNAME=$POD_NAME
fi

TS=$(date)
JAVA_VERSION=$(rpm -qa java-21-openjdk-headless)
TOMCAT_VERSION=$(rpm -qa tomcat.noarch)

echo "$TS $SELF START"
echo "host/pod: $CONTNAME"
echo "user: $USER"
echo "home: $HOME"
echo "image version: $IMAGE_VERSION"
echo "java version: $JAVA_VERSION"
echo "tomcat version: $TOMCAT_VERSION"

# append multiple JVM settings
echo JAVA_OPTS=\"-Xms512m -Xmx2048m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \$JAVA_OPTS\" >> /etc/tomcat/tomcat.conf
echo JAVA_OPTS=\"-XX:+ExitOnOutOfMemoryError \$JAVA_OPTS\" >> /etc/tomcat/tomcat.conf
echo JAVA_OPTS=\"-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/dumps/heapdump_${CONTNAME}_%t.hprof \$JAVA_OPTS\" >> /etc/tomcat/tomcat.conf

if [ -f $CONFDIR/catalina.properties ]; then
    echo "Configure tomcat with extra properties: $CONFDIR/catalina.properties"
    cat $CONFDIR/catalina.properties >> /etc/tomcat/catalina.properties
fi

if [ -f $CONFDIR/war-rename.conf ]; then
    while read line
    do
        MV=$(echo $line | awk '{print $1}')
        if [ "$MV" != "mv" ]; then
            echo "war-rename: $line SKIPPED"
        else
            echo "war-rename: $line"
            cd /usr/share/tomcat/webapps && $line
        fi
    done < $CONFDIR/war-rename.conf
fi

if [ -f $CONFDIR/tomcat.conf ]; then
    echo "Configure tomcat with extra properties: $CONFDIR/tomcat.conf"
    cat $CONFDIR/tomcat.conf >> /etc/tomcat/tomcat.conf
fi

if [ -e $CONFDIR/cacerts ]; then
    echo "Configure CA bundle with extra certificates: $CONFDIR/cacerts"
    cp $CONFDIR/cacerts/* /etc/pki/ca-trust/source/anchors/
fi
# docker build cleaned up, so must run this even without custom CA cert
update-ca-trust

mkdir -p $HOME/.ssl
chmod 700 $HOME/.ssl
for pcf in $CONFDIR/*.pem; do
    echo "Link proxy certificate: $pcf"   
    ln -s $pcf $HOME/.ssl/
done

ln -s /config $HOME/config

TS=$(date)
echo "$TS $SELF DONE"

/usr/libexec/tomcat/server start

